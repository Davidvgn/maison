{
  "rules": {
    "members": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "done": {
      "$period": {
        ".read": "auth != null && root.child('members').child(auth.uid).val() === 'famille'",
        "$kid": {
          ".read": "auth != null && (root.child('members').child(auth.uid).val() === 'famille' || root.child('members').child(auth.uid).val() === $kid)",
          "$task": {
            ".write": "auth != null && (root.child('members').child(auth.uid).val() === 'famille' || root.child('members').child(auth.uid).val() === $kid) && $kid.matches(/^(jeremy|liam|nina)$/) && $period.matches(/^(\\d\\d\\d\\d-\\d\\d-\\d\\d|WE-\\d\\d\\d\\d-W\\d\\d?)$/) && $task.length <= 60 && $task.matches(/^[a-z0-9]+_[A-Za-z0-9]*(_[0-9]+)?$/)",
            ".validate": "newData.isString() && newData.val().matches(/^\\d\\d\\d\\d-\\d\\d-\\d\\d \\d\\d:\\d\\d$/)"
          }
        }
      }
    },
    "house": {
      ".read": "auth != null && root.child('members').child(auth.uid).val().matches(/^(jeremy|liam|nina|famille)$/)",
      "dishwasher": {
        "launched": {
          ".write": "auth != null && root.child('members').child(auth.uid).val() === 'famille'",
          ".validate": "newData.isString() && newData.val().matches(/^\\d\\d\\d\\d-\\d\\d-\\d\\d \\d\\d:\\d\\d$/)"
        },
        "emptied": {
          ".write": "auth != null && root.child('members').child(auth.uid).val().matches(/^(jeremy|liam|nina|famille)$/) && (newData.exists() || root.child('members').child(auth.uid).val() === 'famille')",
          ".validate": "newData.isString() && newData.val() === root.child('house/dishwasher/launched').val()"
        }
      },
      "dryer": {
        "launched": {
          ".write": "auth != null && root.child('members').child(auth.uid).val() === 'famille'",
          ".validate": "newData.isString() && newData.val().matches(/^\\d\\d\\d\\d-\\d\\d-\\d\\d \\d\\d:\\d\\d$/)"
        },
        "out": {
          ".write": "auth != null && root.child('members').child(auth.uid).val().matches(/^(jeremy|liam|nina|famille)$/) && (newData.exists() || root.child('members').child(auth.uid).val() === 'famille')",
          ".validate": "newData.isString() && newData.val() === root.child('house/dryer/launched').val()"
        },
        "folded": {
          ".write": "auth != null && root.child('members').child(auth.uid).val().matches(/^(jeremy|liam|nina|famille)$/) && (newData.exists() || root.child('members').child(auth.uid).val() === 'famille')",
          ".validate": "newData.isString() && newData.val() === root.child('house/dryer/out').val()"
        }
      },
      "rack": {
        "hung": {
          ".write": "auth != null && root.child('members').child(auth.uid).val() === 'famille'",
          ".validate": "newData.isString() && newData.val().matches(/^\\d\\d\\d\\d-\\d\\d-\\d\\d \\d\\d:\\d\\d$/)"
        },
        "jeremy": {
          ".write": "auth != null && (root.child('members').child(auth.uid).val() === 'famille' || (root.child('members').child(auth.uid).val() === 'jeremy' && newData.exists()))",
          ".validate": "newData.isString() && newData.val() === root.child('house/rack/hung').val()"
        },
        "liam": {
          ".write": "auth != null && (root.child('members').child(auth.uid).val() === 'famille' || (root.child('members').child(auth.uid).val() === 'liam' && newData.exists()))",
          ".validate": "newData.isString() && newData.val() === root.child('house/rack/hung').val()"
        },
        "nina": {
          ".write": "auth != null && (root.child('members').child(auth.uid).val() === 'famille' || (root.child('members').child(auth.uid).val() === 'nina' && newData.exists()))",
          ".validate": "newData.isString() && newData.val() === root.child('house/rack/hung').val()"
        }
      }
    }
  }
}
